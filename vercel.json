{
  "version": 2,
  "framework": "vite",
  "outputDirectory": "dist",
  "buildCommand": "npm run build",
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/**/*.js": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "vendor/ffmpeg"
    }
  },
  "rewrites": [
    { "source": "/api/calibration", "destination": "/api/calibration.js" },
    { "source": "/api/calibration/chat", "destination": "/api/calibration-chat.js" },
    { "source": "/api/calibration/reset", "destination": "/api/calibration-reset.js" },
    { "source": "/api/ingest-call", "destination": "/api/ingest-call.js" },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
