# ==============================================================================
# GEMINI API KEYS (ARNÉS MULTI-CUENTA / MULTI-KEY)
# ==============================================================================
# Opción A: Una sola clave
GEMINI_API_KEY="AIzaSyTuClavePrincipal..."

# Opción B: Múltiples claves separadas por coma en la misma variable
# GEMINI_API_KEYS="AIzaSyClave1...,AIzaSyClave2...,AIzaSyClave3..."

# Opción C: Claves numeradas (el arnés las detecta automáticamente del 1 al 10)
# GEMINI_API_KEY_1="AIzaSyClave1..."
# GEMINI_API_KEY_2="AIzaSyClave2..."
# GEMINI_API_KEY_3="AIzaSyClave3..."

# APP_URL: URL donde está alojado el proyecto
APP_URL="https://tu-proyecto.vercel.app"
